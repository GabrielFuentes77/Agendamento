@model List<Agendamento.Models.Medico>
@{
 ViewData["Title"] = "Medicos";

}

 <h1>Medicos</h1>


<table class="table table-striped table-hover">
    
    <thead>
        
        <tr>
            
            <th>Id</th>
            
            <th>Nome</th>
            
            <th>CRM</th>
            
            <th>Especialidade</th>
            
        </tr>
        
    </thead>
    
    <tbody>
         @foreach (var medico in Model)
         {
            
            <tr>
                
                <td>@medico.Id</td>
                            <td>@medico.Nome</td>
                <td>@medico.Crm</td>
                
                <td>@medico.Especialidade</td>
                
            </tr>
             }
        
    </tbody>
    </table>